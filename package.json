{
  "name": "employee-management",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npm run api:dev\" \"npm run start:frontend\"",
    "start:frontend": "ng serve --proxy-config proxy.conf.json",
    "api:dev": "node ./tools/dev-api-server.mjs",
    "build": "node tools/generate-env-prod.cjs && ng build && node tools/sentry-upload-sourcemaps.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "vercel-dev": "node -e \"console.log('Vercel dev ready'); setInterval(() => {}, 1 << 30);\"",
    "postinstall": "node tools/generate-env-prod.cjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:auth": "node tools/seed-demo-user.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.31",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.31",
    "@angular/compiler": "20.3.31",
    "@angular/core": "20.3.31",
    "@angular/forms": "20.3.31",
    "@angular/platform-browser": "20.3.31",
    "@angular/platform-browser-dynamic": "20.3.31",
    "@angular/router": "20.3.31",
    "@prisma/client": "^6.19.3",
    "@sentry/angular": "^10.74.0",
    "@sentry/core": "^10.74.0",
    "@sentry/node": "^10.74.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "lucide-angular": "^0.553.0",
    "mongodb": "^6.21.0",
    "nodemailer": "^9.1.1",
    "rxjs": "~7.8.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tslib": "^2.8.1",
    "zod": "^3.25.76",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.37",
    "@angular/cli": "20.3.37",
    "@angular/compiler-cli": "20.3.31",
    "@sentry/cli": "^3.7.0",
    "@types/jasmine": "~5.1.8",
    "angular-eslint": "21.0.1",
    "autoprefixer": "^10.5.6",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "shadcn-ng": "^1.1.0",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.46.4"
  },
  "type": "module",
  "overrides": {
    "nodemailer": "$nodemailer",
    "postcss": "$postcss",
    "tar": "^7.5.22",
    "picomatch": "^4.0.7",
    "rollup": "^4.59.0",
    "serialize-javascript": "^7.0.5",
    "webpack": "^5.105.0",
    "esbuild": "^0.25.12",
    "tmp": "^0.2.7",
    "uuid": "^11.1.0",
    "deepmerge-ts": "^8.0.2",
    "vite": "^8.2.2",
    "@sigstore/core": "^4.0.1",
    "sigstore": "^5.0.0",
    "diff": "^9.0.0",
    "webpack-dev-server": "^5.2.1",
    "piscina": "^4.9.3",
    "@babel/core": "^7.29.1",
    "less": "^4.9.0",
    "js-yaml": "^4.3.2",
    "qs": "^6.16.0",
    "hono": "^4.13.7"
  }
}
