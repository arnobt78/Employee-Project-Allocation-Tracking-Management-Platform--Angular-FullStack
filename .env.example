# =============================================================================
# EmpowerHub — environment template
# Copy to `.env` for local API (`npm run api:dev`). Never commit real secrets.
#
# CLIENT vs SERVER
# - Public / client-safe: APP_BASE_URL, NG_APP_API_BASE_URL, NG_APP_FEATURE_*, SENTRY_DSN
# - Server-only secrets: DATABASE_URL, AI keys, CMS_*, RESEND_*, SMTP_*, SESSION_*, SENTRY_AUTH_TOKEN
# - NEVER put AI / CMS / email / DB / SENTRY_AUTH_TOKEN under NG_APP_*
# =============================================================================

# --- Database (server) ---
DATABASE_URL="mongodb://localhost:27017/employee-management"

# --- Local API ---
API_PORT=4310

# Public app URL (email links). On Vercel use your production URL, not localhost.
APP_BASE_URL=http://localhost:4200

# Angular public API base (proxied in dev). Safe in client bundle.
NG_APP_API_BASE_URL=/api/employee-management/

# Feature flags (public / client-safe)
NG_APP_FEATURE_READINESS_V2=true
NG_APP_FEATURE_AI_SUMMARY=false
NG_APP_FEATURE_WORKFLOW_TIMELINE=false

# Session cookie TTL (hours). Server-only. Default 24 if unset.
SESSION_TTL_HOURS=24

# Demo login is hardcoded in the app (admin / 112233) + seeded via:
#   npm run db:seed:auth
# Do NOT add NG_APP_DEMO_USERNAME / NG_APP_DEMO_PASSWORD.

# =============================================================================
# AI — free-tier multi-provider fallback (server-only)
# Chain: Gemini → Groq → OpenRouter (:free) → Hugging Face
# Docs: docs/LLM_MODEL_SELECTION.md
# =============================================================================

# Google AI Studio — https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=

# GroqCloud — https://console.groq.com/keys
GROQ_LLAMA_API_KEY=

# Optional extra free-tier fallbacks
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# =============================================================================
# Contentful CMS (server-only)
# https://app.contentful.com → Settings → API keys
# =============================================================================
CMS_SPACE_ID=
CMS_ENVIRONMENT=master
CMS_DELIVERY_TOKEN=
CMS_PREVIEW_TOKEN=

# =============================================================================
# Email (server-only)
# Resend: https://resend.com/api-keys
# SMTP: Gmail app password, Mailgun, etc.
# =============================================================================
RESEND_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="EmpowerHub <no-reply@example.com>"
EMAIL_DRY_RUN=false

# Always-notify addresses (comma-separated). Added to To/CC on project,
# assignment, employee, and approval emails — on top of stakeholder emails
# from the DB. Leave empty to only email people attached to the record.
NOTIFY_APPROVAL_TO=

# =============================================================================
# Sentry error tracking (Angular SPA + Vercel Functions)
# Docs: docs/Redis_Sentry_PostHog_INTEGRATION_GUIDE.md (§2B pattern; this repo)
#
# - Empty SENTRY_DSN = Sentry disabled (safe for local without keys)
# - Same-origin tunnel: POST /api/monitoring (bypasses ad blockers)
# - Client DSN is public by design; baked into production build via postinstall
# - NEVER put SENTRY_AUTH_TOKEN under NG_APP_* or in the Angular bundle
#
# Vercel: set SENTRY_DSN, SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN
# then redeploy. Dashboard → Inbound Filters → ignore browser extensions.
# =============================================================================

# Primary DSN (client + server + tunnel allowlist)
# Get: Sentry → Project Settings → Client Keys (DSN)
SENTRY_DSN=

# Optional DSN aliases (accepted if SENTRY_DSN unset):
# NG_APP_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Build-time source map upload (Vercel CI only — not a browser secret beyond build env)
# Org slug: Sentry → Settings → General → Organization slug
SENTRY_ORG=
# Project slug (NOT the org name): Project Settings → General
SENTRY_PROJECT=employee-management
# Auth token: Settings → Auth Tokens (scopes: project:releases, org:read)
SENTRY_AUTH_TOKEN=
